// Copy to `Secrets.xcconfig` (gitignored) and fill in the built-in app keys.
// Get a Last.fm API account: https://www.last.fm/api/account/create
LASTFM_API_KEY =
LASTFM_SHARED_SECRET =

// Apple Music developer token (JWT) for catalog artist images. Optional, and
// now only a FALLBACK: builds mint this token from the MusicKit .p8 instead
// (parachord-mobile#186), via the "Embed Apple Music developer token" build
// phase. Configure APPLE_MUSIC_P8_PATH / APPLE_MUSIC_KEY_ID /
// APPLE_MUSIC_TEAM_ID in the repo-root local.properties to enable generation.
// Leave this blank unless you have a pre-generated token but no .p8.
APPLE_MUSIC_DEVELOPER_TOKEN =

// Achordion bearer token — pre-warms Achordion's track-links cache on scrobble
// + share (#215). Same shared app token as Android local.properties
// ACHORDION_BEARER_TOKEN. Optional: blank = submit short-circuits inertly.
ACHORDION_BEARER_TOKEN =
