<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <!-- City-level GPS for concert location detection. COARSE only — concerts
         need city precision, not street-level (matches iOS reduced accuracy). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- The CAL media templates permission (the drive UI as templates). -->
    <uses-permission
        android:name="androidx.car.app.MEDIA_TEMPLATES" />

    <!-- The CAL automotive artifact's CarAppActivity wants minSdk 29; our minSdk
         is 26, but the car templates only ever launch on AAOS cars (API 29+). -->
    <uses-sdk tools:overrideLibrary="androidx.car.app.automotive" />

    <!-- The app runs on a car's own Android too (Android Automotive, e.g. a
         Volvo EX90): on such a device the car's template host launches the CAL
         media-templates drive UI. required="false" so phones install it unchanged
         and older AAOS cars (Android 10–13, no templates host) fall back to the
         system Media Center rendering our browse tree. -->
    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="false" />
    <uses-feature
        android:name="android.software.car.templates_host.media"
        android:required="false" />

    <!--
      Package visibility (Android 11+): without this Parachord can't see Spotify,
      so getLaunchIntentForPackage("com.spotify.music") returns null and the
      wake's launch-intent fallback reported "Spotify is not installed" (found
      on a Pixel in the #459 spike).
    -->
    <queries>
        <package android:name="com.spotify.music" />
        <!-- Android Auto's car-connection state (CarConnections.confirmed). -->
        <provider android:authorities="androidx.car.app.connection" />
        <!-- A browser, for OAuth on a car: Custom Tabs fall back to a plain
             ACTION_VIEW when no custom-tab provider resolves (Android
             Automotive has Chrome Beta, or the OEM's own link viewer). -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".app.ParachordApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Parachord"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- The CAL media templates host reads the min car API level from here. -->
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="8" />

        <!--
            Android Auto media app descriptor. Declares Parachord as a media
            app so it appears in Android Auto's app list. See
            res/xml/automotive_app_desc.xml.
        -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <!--
            OAuth redirect receiver. Dedicated activity with noHistory="true"
            and Theme.NoDisplay so Chrome Custom Tabs auto-close when the
            callback fires. Forwards the redirect URI to MainActivity.
        -->
        <activity
            android:name=".auth.OAuthRedirectActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <!--
                High priority to beat MainActivity's catch-all parachord://
                filter for the specific auth host — otherwise Android shows
                a disambiguation chooser when the redirect fires.
            -->
            <intent-filter android:priority="999">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="parachord"
                    android:host="auth" />
            </intent-filter>
        </activity>

        <!--
            A web session's visible sign-in screen (the webSession host
            bridge). Not exported: only the app starts it. configChanges keeps
            a rotation from recreating it mid sign-in.
        -->
        <activity
            android:name=".websession.WebSessionSignInActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode"
            android:theme="@style/Theme.Parachord" />

        <activity
            android:name=".ui.ParachordActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Parachord">
            <!--
                Deep links for all Parachord protocol URLs. Hosts are listed
                explicitly (rather than a catch-all scheme match) so that the
                auth host goes ONLY to OAuthRedirectActivity and Android's
                intent resolver doesn't show a disambiguation chooser on the
                OAuth callback. See OAuthRedirectActivity.kt.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <!-- Playback -->
                <data android:scheme="parachord" android:host="play" />
                <data android:scheme="parachord" android:host="control" />
                <data android:scheme="parachord" android:host="queue" />
                <data android:scheme="parachord" android:host="shuffle" />
                <data android:scheme="parachord" android:host="volume" />
                <data android:scheme="parachord" android:host="listen-along" />
                <!-- Navigation -->
                <data android:scheme="parachord" android:host="home" />
                <data android:scheme="parachord" android:host="artist" />
                <data android:scheme="parachord" android:host="album" />
                <data android:scheme="parachord" android:host="library" />
                <data android:scheme="parachord" android:host="history" />
                <data android:scheme="parachord" android:host="friend" />
                <data android:scheme="parachord" android:host="recommendations" />
                <data android:scheme="parachord" android:host="charts" />
                <data android:scheme="parachord" android:host="critics-picks" />
                <data android:scheme="parachord" android:host="playlists" />
                <data android:scheme="parachord" android:host="playlist" />
                <data android:scheme="parachord" android:host="settings" />
                <data android:scheme="parachord" android:host="search" />
                <data android:scheme="parachord" android:host="chat" />
                <!-- Import -->
                <data android:scheme="parachord" android:host="import" />
            </intent-filter>

            <!-- Universal-Links / App-Links HTTPS counterpart to parachord://.
                 Auto-verifies against https://parachord.com/.well-known/assetlinks.json
                 (lives in the parachord-website repo). Until the website ships
                 that file, taps to https://parachord.com/<verb> show Android's
                 chooser dialog ("Open with: Parachord / Browser"). After the
                 website ships and Android re-verifies (24h propagation,
                 can be forced with the `pm verify-app-links` adb command
                 + re-verify flag), the chooser disappears and Parachord
                 opens directly.

                 Filter belongs on MainActivity, NOT OAuthRedirectActivity —
                 that one is OAuth-only and uses parachord://auth/...

                 autoVerify is on the filter, not the data tags — Android
                 verifies the host once per filter.

                 Paths mirror the parachord:// host list above. New verbs
                 added later need entries here too. Tracked by #122 / #123. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="parachord.com" />
                <!-- Playback -->
                <data android:path="/play" />
                <data android:pathPrefix="/play/" />
                <data android:path="/listen-along" />
                <data android:path="/import" />
                <data android:pathPrefix="/queue/" />
                <data android:pathPrefix="/control/" />
                <data android:pathPrefix="/shuffle/" />
                <data android:pathPrefix="/volume/" />
                <!-- Navigation -->
                <data android:pathPrefix="/artist/" />
                <data android:pathPrefix="/album/" />
                <data android:pathPrefix="/library" />
                <data android:pathPrefix="/history" />
                <data android:pathPrefix="/friend/" />
                <data android:pathPrefix="/recommendations" />
                <data android:path="/charts" />
                <data android:path="/critics-picks" />
                <data android:path="/playlists" />
                <data android:pathPrefix="/playlist/" />
                <data android:pathPrefix="/settings" />
                <data android:path="/search" />
                <data android:path="/chat" />
                <data android:path="/home" />
            </intent-filter>

            <!-- Spotify web URLs -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="open.spotify.com" android:pathPrefix="/track" />
                <data android:scheme="https" android:host="open.spotify.com" android:pathPrefix="/album" />
                <data android:scheme="https" android:host="open.spotify.com" android:pathPrefix="/playlist" />
                <data android:scheme="https" android:host="open.spotify.com" android:pathPrefix="/artist" />
            </intent-filter>

            <!-- Spotify URIs (spotify:track:xxx) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="spotify" />
            </intent-filter>

            <!-- Apple Music URLs — scoped to supported content types only.
                 The catch-all "/" prefix caused Parachord to appear in the chooser
                 for every music.apple.com URL including /browse, /curator, etc.
                 that we have no handler for. security: M10 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="music.apple.com" android:pathPattern="/.*/.*/album/.*" />
                <data android:scheme="https" android:host="music.apple.com" android:pathPattern="/.*/.*/song/.*" />
                <data android:scheme="https" android:host="music.apple.com" android:pathPattern="/.*/.*/playlist/.*" />
                <data android:scheme="https" android:host="music.apple.com" android:pathPattern="/.*/.*/artist/.*" />
            </intent-filter>

            <!-- Share sheet: accept shared URLs from other apps (Spotify, Apple Music, browsers) -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!--
            The phone's launcher entry: kept under the original `.ui.MainActivity`
            component name as an alias targeting `.ui.ParachordActivity` (declared
            above per Android's activity-alias contract) so existing phone
            home-screen shortcuts survive updates, while the car can drop the
            launcher alias at runtime (CarLauncherMode) without disabling
            ParachordActivity itself (the CAL drive app opens it from "Open
            Parachord" while parked). Phones never flip anything: this alias is
            their only launcher icon.
        -->
        <activity-alias
            android:name=".ui.MainActivity"
            android:targetActivity=".ui.ParachordActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <!--
                The AAOS media-card opt-in: without this the car's launcher logs
                "No opt-in info found ... Skipping MBS ... belonging to non media
                template app" and won't open the app's own UI from the media
                card. The system's own radio app declares the same key (false);
                true marks the app launchable from the media card, which opens
                the CAL drive app (the launcher entry on a car).
            -->
            <meta-data
                android:name="androidx.car.app.launchable"
                android:value="true" />
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!--
            The AAOS drive UI as CAL media templates (Android 14+ cars with the
            media templates host). The car's template host renders every screen
            and enforces driver-distraction compliance; our Media3 session feeds
            the playback state, the Assistant and the car's media card.
        -->
        <service
            android:name=".car.cal.CalCarAppService"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.MEDIA" />
            </intent-filter>
        </service>

        <!--
            The CAL drive app's launcher entry. Disabled by default so phones
            never see a second icon; a car with the templates host enables it
            at process start (CarLauncherMode) and drops the phone alias, so the
            car launcher — and the home-screen media card's tap-out, which
            resolves the launcher intent — open the drive app.
        -->
        <activity
            android:name="androidx.car.app.activity.CarAppActivity"
            android:enabled="false"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <!--
                Required by AAOS CarPackageManager so the CAL drive UI stays
                accessible while driving (the templates host enforces distraction
                compliance by construction; ParachordActivity omits this so the
                full app stays parked-only).
            -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
                The AAOS media-center opt-in for apps with their own UI: the car
                opens this activity from the media card and the media center
                instead of the generic browse (without it the system logs
                "Skipping MBS ... belonging to non media template app" and won't
                treat the app as a media-template app).
            -->
            <intent-filter>
                <action android:name="android.car.intent.action.MEDIA_TEMPLATE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.MiniPlayerWidgetProvider"
            android:exported="false"
            android:label="Parachord Player">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/mini_player_widget_info" />
        </receiver>

        <!-- Exposes playlist mosaic art (private filesDir) to other processes
             — notably Android Auto (gearhead), which can't read our private
             file:// URIs. Media3's MediaSession auto-grants connected
             controllers read permission for content:// artwork URIs. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Read-only artwork provider serving content://<applicationId>.artwork/<key>
             URIs for session metadata and browse items. AAOS's car-media-common
             (both the CAL Templates Host's MediaPlaybackTemplate and CarLauncher's
             home media card) ignores raw bitmaps and refuses remote https:// URIs,
             decoding only local content:// URIs via ContentResolver. -->
        <provider
            android:name=".playback.MediaArtworkProvider"
            android:authorities="${applicationId}.artwork"
            android:exported="true" />

    </application>

</manifest>
